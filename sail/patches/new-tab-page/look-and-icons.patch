+// Sail: Google's apps show a sign-in page to a request without cookies, so
+// their icons come from Google's own set of product icons.
+GURL GoogleAppIcon(const GURL& page_url) {
+  static constexpr std::pair<std::string_view, std::string_view> kApps[] = {
+      {"mail.google.com", "gmail_2020q4"},
+      {"drive.google.com", "drive_2020q4"},
+      {"calendar.google.com", "calendar_2020q4"},
+      {"docs.google.com", "docs_2020q4"},
+      {"meet.google.com", "meet_2020q4"},
+  };
+  for (const auto& [host, name] : kApps) {
+    if (page_url.host() == host) {
+      return GURL(base::StrCat(
+          {"https://www.gstatic.com/images/branding/product/2x/", name,
+           "_96dp.png"}));
+    }
+  }
+  return GURL();
+}
+
+std::string LinkAttribute(std::string_view tag, std::string_view name) {
+  const RE2 pattern(base::StrCat(
+      {R"re((?i)\b)re", name,
+       R"re(\s*=\s*(?:"([^"]*)"|'([^']*)'|([^\s>]+)))re"}));
+  std::string double_quoted, single_quoted, bare;
+  if (!RE2::PartialMatch(tag, pattern, &double_quoted, &single_quoted, &bare)) {
+    return std::string();
+  }
+  return !double_quoted.empty() ? double_quoted
+         : !single_quoted.empty() ? single_quoted
+                                  : bare;
+}
+
+// The best icon the page declares: an apple-touch-icon (made to fill a
+// square, like an app icon), else the largest PNG/ICO icon of 96 px or more.
+// SVG is skipped: chrome://image cannot decode it.
+std::pair<GURL, bool> PickSailIcon(std::string_view html, const GURL& base) {
+  static const base::NoDestructor<RE2> kLink(R"((?i)(<link\b[^>]*>))");
+  std::string_view input = html.substr(0, 512 * 1024);
+  std::string tag;
+  GURL best;
+  bool best_full = false;
+  int best_score = 0;
+  while (RE2::FindAndConsume(&input, *kLink, &tag)) {
+    const std::string rel = base::ToLowerASCII(LinkAttribute(tag, "rel"));
+    const std::string href = LinkAttribute(tag, "href");
+    if (href.empty()) {
+      continue;
+    }
+    const std::string type = base::ToLowerASCII(LinkAttribute(tag, "type"));
+    const GURL url = base.Resolve(href);
+    if (!url.SchemeIs(url::kHttpsScheme) ||
+        type.find("svg") != std::string::npos ||
+        base::EndsWith(url.path(), ".svg",
+                       base::CompareCase::INSENSITIVE_ASCII)) {
+      continue;
+    }
+    int size = 0;
+    for (std::string_view part :
+         base::SplitStringPiece(LinkAttribute(tag, "sizes"), " ",
+                                base::TRIM_WHITESPACE,
+                                base::SPLIT_WANT_NONEMPTY)) {
+      int width = 0;
+      const size_t x = part.find_first_of("xX");
+      if (x != std::string_view::npos &&
+          base::StringToInt(part.substr(0, x), &width)) {
+        size = std::max(size, width);
+      }
+    }
+    const std::vector<std::string_view> rels = base::SplitStringPiece(
+        rel, " ", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY);
+    const bool touch = rel.find("apple-touch-icon") != std::string::npos;
+    const bool icon = std::ranges::find(rels, "icon") != rels.end();
+    int score = 0;
+    if (touch) {
+      score = 10000 + (size ? size : 180);
+    } else if (icon && size >= 96) {
+      score = size;
+    }
+    if (score > best_score) {
+      best_score = score;
+      best = url;
+      best_full = touch;
+    }
+  }
+  return {best, best_full};
+}
+
+}  // namespace
+
+void NewTabPageHandler::FindSailIcon(const GURL& page_url,
+                                     FindSailIconCallback callback) {
+  if (const GURL google = GoogleAppIcon(page_url); google.is_valid()) {
+    std::move(callback).Run(google.spec(), false);
+    return;
+  }
+  if (!page_url.SchemeIs(url::kHttpsScheme)) {
+    std::move(callback).Run(std::string(), false);
+    return;
+  }
+  auto traffic_annotation =
+      net::DefineNetworkTrafficAnnotation("sail_new_tab_page_site_icon", R"(
+        semantics {
+          sender: "Sail New Tab Page"
+          description:
+            "Reads the page of a New Tab Page shortcut to find the large icon "
+            "it declares, so that the shortcut can show it sharply."
+          trigger: "A shortcut is shown on the New Tab Page for the first "
+            "time in a week."
+          data: "None. The request carries no cookies."
+          destination: WEBSITE
+        }
+        policy {
+          cookies_allowed: NO
+          setting: "Give the shortcut your own icon from its Edit dialog."
+          policy_exception_justification: "Sail feature, no policy."
+        })");
+  auto request = std::make_unique<network::ResourceRequest>();
+  request->url = page_url;
+  request->credentials_mode = network::mojom::CredentialsMode::kOmit;
+  request->headers.SetHeader(net::HttpRequestHeaders::kAccept, "text/html");
+  auto loader =
+      network::SimpleURLLoader::Create(std::move(request), traffic_annotation);
+  loader->SetTimeoutDuration(base::Seconds(10));
+  loader->DownloadToString(
+      profile_->GetURLLoaderFactory().get(),
+      base::BindOnce(&NewTabPageHandler::OnSailPageLoaded,
+                     weak_ptr_factory_.GetWeakPtr(), loader.get(),
+                     std::move(callback)),
+      2 * 1024 * 1024);
+  loader_map_.insert({loader.get(), std::move(loader)});
+}
+
+void NewTabPageHandler::OnSailPageLoaded(
+    const network::SimpleURLLoader* loader,
+    FindSailIconCallback callback,
+    std::optional<std::string> body) {
+  const GURL page = loader->GetFinalURL();
+  auto [icon, full_bleed] =
+      body ? PickSailIcon(*body, page) : std::pair<GURL, bool>();
+  if (!icon.is_valid() && page.SchemeIs(url::kHttpsScheme)) {
+    // Many sites keep their app icon at the conventional address.
+    icon = page.GetWithEmptyPath().Resolve("/apple-touch-icon.png");
+    full_bleed = true;
+  }
+  loader_map_.erase(loader);
+  std::move(callback).Run(icon.is_valid() ? icon.spec() : std::string(),
+                          full_bleed);
+}
+
+void NewTabPageHandler::GetSailLook(GetSailLookCallback callback) {
+  PrefService* prefs = profile_->GetPrefs();
+  std::move(callback).Run(prefs->GetString(sail::prefs::kNtpLook),
+                          prefs->GetString(sail::prefs::kNtpIcons));
+}
+
+void NewTabPageHandler::SetSailIcons(const std::string& icons) {
+  profile_->GetPrefs()->SetString(sail::prefs::kNtpIcons, icons);
+}
