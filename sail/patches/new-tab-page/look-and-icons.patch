+// Copyright 2026 The Sail Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+// Sail: the "Page style" card of the Customize panel. It sets the look of the
+// New Tab page: the size of the shortcuts, glass behind their icons, their
+// names, a clock with a greeting, and how dark and blurred the wallpaper is.
+// The page itself (new_tab_page/app.ts) reads the same settings.
+
+import 'chrome://resources/cr_elements/cr_button/cr_button.js';
+import 'chrome://resources/cr_elements/cr_toggle/cr_toggle.js';
+
+import {CrLitElement} from 'chrome://resources/lit/v3_0/lit.rollup.js';
+
+import {CustomizeChromeApiProxy} from './customize_chrome_api_proxy.js';
+import {getCss} from './sail_look.css.js';
+import {getHtml} from './sail_look.html.js';
+
+export interface SailLook {
+  size: number;
+  glass: boolean;
+  titles: boolean;
+  clock: boolean;
+  dim: number;
+  blur: number;
+}
+
+type SailLookKey = keyof SailLook;
+
+const DEFAULTS: SailLook =
+    {size: 112, glass: false, titles: true, clock: false, dim: 0, blur: 0};
+
+const ITALIAN = document.documentElement.lang.startsWith('it');
+
+export const SAIL_LOOK_TEXT = {
+  title: ITALIAN ? 'Stile della pagina' : 'Page style',
+  size: ITALIAN ? 'Grandezza delle scorciatoie' : 'Shortcut size',
+  small: ITALIAN ? 'Piccole' : 'Small',
+  large: ITALIAN ? 'Grandi' : 'Large',
+  glass: ITALIAN ? 'Vetro dietro le icone' : 'Glass behind the icons',
+  titles: ITALIAN ? 'Nomi delle scorciatoie' : 'Shortcut names',
+  clock: ITALIAN ? 'Orologio e saluto' : 'Clock and greeting',
+  dim: ITALIAN ? 'Scurisci lo sfondo' : 'Darken the wallpaper',
+  blur: ITALIAN ? 'Sfoca lo sfondo' : 'Blur the wallpaper',
+  reset: ITALIAN ? 'Ripristina' : 'Reset',
+  iconHint: ITALIAN ?
+      'Per dare a una scorciatoia un\'icona tua: ⋮ sulla scorciatoia → ' +
+          'Modifica.' :
+      'To give a shortcut your own icon: ⋮ on the shortcut → Edit.',
+};
+
+export function sailLookTitle(): string {
+  return SAIL_LOOK_TEXT.title;
+}
+
+function parse(json: string): SailLook {
+  let values: Record<string, unknown> = {};
+  try {
+    const parsed: unknown = JSON.parse(json);
+    if (parsed && typeof parsed === 'object') {
+      values = parsed as Record<string, unknown>;
+    }
+  } catch {
+    // Keep the defaults.
+  }
+  const look: SailLook = {...DEFAULTS};
+  const numbers: Array<'size'|'dim'|'blur'> = ['size', 'dim', 'blur'];
+  for (const key of numbers) {
+    const value = values[key];
+    if (typeof value === 'number') {
+      look[key] = value;
+    }
+  }
+  const flags: Array<'glass'|'titles'|'clock'> = ['glass', 'titles', 'clock'];
+  for (const key of flags) {
+    const value = values[key];
+    if (typeof value === 'boolean') {
+      look[key] = value;
+    }
+  }
+  return look;
+}
+
+export class SailLookElement extends CrLitElement {
+  static get is() {
+    return 'customize-chrome-sail-look';
+  }
+
+  static override get styles() {
+    return getCss();
+  }
+
+  override render() {
+    return getHtml.bind(this)();
+  }
+
+  static override get properties() {
+    return {
+      look: {type: Object},
+    };
+  }
+
+  accessor look: SailLook = {...DEFAULTS};
+  private listenerId_: number|null = null;
+  private frame_ = 0;
+
+  override connectedCallback() {
+    super.connectedCallback();
+    const proxy = CustomizeChromeApiProxy.getInstance();
+    this.listenerId_ = proxy.callbackRouter.setSailLook.addListener(
+        (look: string) => this.look = parse(look));
+    proxy.handler.updateSailLook();
+  }
+
+  override disconnectedCallback() {
+    super.disconnectedCallback();
+    CustomizeChromeApiProxy.getInstance().callbackRouter.removeListener(
+        this.listenerId_!);
+    cancelAnimationFrame(this.frame_);
+  }
+
+  private keyOf_(e: Event): SailLookKey {
+    return (e.currentTarget as HTMLElement).dataset['key'] as SailLookKey;
+  }
+
+  protected onSliderInput_(e: Event) {
+    const key = this.keyOf_(e) as 'size' | 'dim' | 'blur';
+    this.change_({[key]: Number((e.target as HTMLInputElement).value)});
+  }
+
+  protected onToggleChange_(e: CustomEvent<boolean>) {
+    const key = this.keyOf_(e) as 'glass' | 'titles' | 'clock';
+    this.change_({[key]: e.detail});
+  }
+
+  protected onLabelClick_(e: Event) {
+    const key = this.keyOf_(e) as 'glass' | 'titles' | 'clock';
+    this.change_({[key]: !this.look[key]});
+  }
+
+  protected onResetClick_() {
+    this.change_({...DEFAULTS});
+  }
+
+  private change_(change: Partial<SailLook>) {
+    this.look = {...this.look, ...change};
+    // Sliders send many events: store at most once a frame.
+    if (!this.frame_) {
+      this.frame_ = requestAnimationFrame(() => {
+        this.frame_ = 0;
+        CustomizeChromeApiProxy.getInstance().handler.setSailLook(
+            JSON.stringify(this.look));
+      });
+    }
+  }
+}
+
+declare global {
+  interface HTMLElementTagNameMap {
+    'customize-chrome-sail-look': SailLookElement;
+  }
+}
+
+customElements.define(SailLookElement.is, SailLookElement);
