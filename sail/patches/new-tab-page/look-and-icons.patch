+  // Sail: the shortcuts' own icons. They are kept by URL and handed to the
+  // page, which stores them, through a 'sail-icons-change' event.
+  private saveSailIcon_(oldUrl: string, newUrl: string, icon: string) {
+    const icons = {...this.sailIcons};
+    if (oldUrl !== newUrl) {
+      delete icons[oldUrl];
+    }
+    if (icon) {
+      icons[newUrl] = icon;
+    } else {
+      delete icons[newUrl];
+    }
+    if (JSON.stringify(icons) === JSON.stringify(this.sailIcons)) {
+      return;
+    }
+    this.sailIcons = icons;
+    this.fire('sail-icons-change', icons);
+  }
+
+  // The shortcut's own icon, else the site's large icon, else its favicon.
+  // App icons fill the square; other large icons nearly fill it.
+  protected getSailIcon_(url: Url): string {
+    return this.sailIcons[url] || this.sailSiteIcons[url]?.src || '';
+  }
+
+  protected getSailIconClass_(url: Url): string {
+    if (this.sailIcons[url]) {
+      return 'sail-custom';
+    }
+    const site = this.sailSiteIcons[url];
+    if (!site) {
+      return '';
+    }
+    return site.full ? 'sail-custom' : 'sail-large';
+  }
+
+  // The icon the shortcut will have: the chosen one, else the site's large
+  // icon, else its favicon.
+  protected getSailDialogPreview_(): string {
+    if (this.sailDialogIcon_) {
