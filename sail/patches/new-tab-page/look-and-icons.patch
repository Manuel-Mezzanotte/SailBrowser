+
+import {html} from '//resources/lit/v3_0/lit.rollup.js';
+
+import type {SailLookElement} from './sail_look.js';
+import {SAIL_LOOK_TEXT as TEXT} from './sail_look.js';
+
+export function getHtml(this: SailLookElement) {
+  // clang-format off
+  return html`<!--_html_template_start_-->
+<div class="slider">
+  <span class="label">${TEXT.size}</span>
+  <input type="range" min="80" max="176" step="8"
+      .value="${String(this.look.size)}" aria-label="${TEXT.size}"
+      data-key="size" @input="${this.onSliderInput_}">
+  <div class="ends"><span>${TEXT.small}</span><span>${TEXT.large}</span></div>
+</div>
+${(['glass', 'titles', 'clock'] as const).map(key => html`
+  <div class="row">
+    <label data-key="${key}" @click="${this.onLabelClick_}">${TEXT[key]}</label>
+    <cr-toggle ?checked="${this.look[key]}" aria-label="${TEXT[key]}"
+        data-key="${key}" @change="${this.onToggleChange_}">
+    </cr-toggle>
+  </div>
+`)}
+<div class="slider">
+  <span class="label">${TEXT.dim}</span>
+  <input type="range" min="0" max="70" step="5"
+      .value="${String(this.look.dim)}" aria-label="${TEXT.dim}"
+      data-key="dim" @input="${this.onSliderInput_}">
+</div>
+<div class="slider">
+  <span class="label">${TEXT.blur}</span>
+  <input type="range" min="0" max="30" step="2"
+      .value="${String(this.look.blur)}" aria-label="${TEXT.blur}"
+      data-key="blur" @input="${this.onSliderInput_}">
+</div>
+<div class="hint">${TEXT.iconHint}</div>
+<cr-button id="reset" @click="${this.onResetClick_}">${TEXT.reset}</cr-button>
+<!--_html_template_end_-->`;
+  // clang-format on
+}
