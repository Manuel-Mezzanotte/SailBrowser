+// Sail: like in Arc (and Oblò), the window never leaves the screens. It moves
+// from one screen to the next where they touch, stops at the free edges, the
+// menu bar and the Dock, and slides along an edge when pushed diagonally.
+struct ScreenAreas {
+  // Where the window may come to rest: the work area of every screen.
+  std::vector<gfx::Rect> rest;
+  // Where it may pass while dragged: also the menu bar or Dock strip of a
+  // screen that has another screen on that side, or it could never cross
+  // from one to the other.
+  std::vector<gfx::Rect> pass;
+};
+
+ScreenAreas GetScreenAreas() {
+  ScreenAreas areas;
+  const std::vector<display::Display>& displays =
+      display::Screen::Get()->GetAllDisplays();
+  for (const display::Display& display : displays) {
+    areas.rest.push_back(display.work_area());
+  }
+  areas.pass = areas.rest;
+
+  const auto near = [](int a, int b) { return std::abs(a - b) < 2; };
+  const auto crosses = [](int a1, int a2, int b1, int b2) {
+    return a1 < b2 && b1 < a2;
+  };
+  for (const display::Display& display : displays) {
+    const gfx::Rect f = display.bounds();
+    const gfx::Rect a = display.work_area();
+    // The strips outside the work area, each with the side that bounds it.
+    const gfx::Rect strips[] = {
+        gfx::Rect(f.x(), f.y(), f.width(), a.y() - f.y()),
+        gfx::Rect(f.x(), a.bottom(), f.width(), f.bottom() - a.bottom()),
+        gfx::Rect(f.x(), a.y(), a.x() - f.x(), a.height()),
+        gfx::Rect(a.right(), a.y(), f.right() - a.right(), a.height()),
+    };
+    for (size_t side = 0; side < std::size(strips); ++side) {
+      if (strips[side].IsEmpty()) {
+        continue;
+      }
+      for (const display::Display& other : displays) {
+        if (other.id() == display.id()) {
+          continue;
+        }
+        const gfx::Rect o = other.bounds();
+        bool touches = false;
+        switch (side) {
+          case 0:  // Menu bar: a screen above.
+            touches = near(o.bottom(), f.y()) &&
+                      crosses(o.x(), o.right(), f.x(), f.right());
+            break;
+          case 1:  // Dock at the bottom: a screen below.
+            touches = near(o.y(), f.bottom()) &&
+                      crosses(o.x(), o.right(), f.x(), f.right());
+            break;
+          case 2:  // Dock on the left: a screen to the left.
+            touches = near(o.right(), f.x()) &&
+                      crosses(o.y(), o.bottom(), a.y(), a.bottom());
+            break;
+          case 3:  // Dock on the right: a screen to the right.
+            touches = near(o.x(), f.right()) &&
+                      crosses(o.y(), o.bottom(), a.y(), a.bottom());
+            break;
+        }
+        if (touches) {
+          areas.pass.push_back(strips[side]);
+          break;
+        }
+      }
+    }
+  }
+  return areas;
+}
+
+int64_t Overlap(const gfx::Rect& a, const gfx::Rect& b) {
+  const gfx::Rect overlap = gfx::IntersectRects(a, b);
+  return static_cast<int64_t>(overlap.width()) * overlap.height();
+}
+
+// Whether `rect` lies entirely on `areas`. The areas never overlap, so it is
+// enough that the parts on each of them add up to the whole window.
+bool Fits(const std::vector<gfx::Rect>& areas, const gfx::Rect& rect) {
+  int64_t covered = 0;
+  for (const gfx::Rect& area : areas) {
+    covered += Overlap(area, rect);
+  }
+  return covered >= static_cast<int64_t>(rect.width()) * rect.height();
+}
+
+// Goes from `start` towards `end` while `ok` holds: in steps of 16 px, then
+// to the pixel.
+template <typename Ok>
+int Farthest(int start, int end, Ok ok) {
+  int good = start;
+  while (good != end) {
+    const int next =
+        end > good ? std::min(good + 16, end) : std::max(good - 16, end);
+    if (!ok(next)) {
+      int bad = next;
+      while (std::abs(bad - good) > 1) {
+        const int mid = good + (bad - good) / 2;
+        if (ok(mid)) {
+          good = mid;
+        } else {
+          bad = mid;
+        }
+      }
+      return good;
+    }
+    good = next;
+  }
+  return good;
+}
+
+// Puts `rect` inside the area it is mostly on (or the closest one).
+gfx::Rect ClampToScreens(const std::vector<gfx::Rect>& areas,
+                         const gfx::Rect& rect) {
+  if (areas.empty()) {
+    return rect;
+  }
+  const gfx::Point center = rect.CenterPoint();
+  const gfx::Rect* best = &areas.front();
+  double best_score = -std::numeric_limits<double>::infinity();
+  for (const gfx::Rect& area : areas) {
+    const int dx = std::max({area.x() - center.x(), 0, center.x() - area.right()});
+    const int dy =
+        std::max({area.y() - center.y(), 0, center.y() - area.bottom()});
+    const double score = Overlap(area, rect) - std::hypot(dx, dy);
+    if (score > best_score) {
+      best_score = score;
+      best = &area;
+    }
+  }
+  const auto clamp = [](int value, int min, int max) {
+    return std::min(std::max(value, min), std::max(min, max));
+  };
+  return gfx::Rect(clamp(rect.x(), best->x(), best->right() - rect.width()),
+                   clamp(rect.y(), best->y(), best->bottom() - rect.height()),
+                   rect.width(), rect.height());
+}
+
+// Where the window gets to when it starts at `from` and wants to go to
+// `target`: first horizontally, then vertically, then horizontally again (for
+// corners).
+gfx::Rect Reach(const std::vector<gfx::Rect>& areas,
+                const gfx::Rect& from,
+                const gfx::Rect& target) {
+  if (Fits(areas, target)) {
+    return target;
+  }
+  if (!Fits(areas, from)) {
+    return ClampToScreens(areas, target);
+  }
+  const auto ok = [&](int x, int y) {
+    return Fits(areas, gfx::Rect(x, y, target.width(), target.height()));
+  };
+  int x = Farthest(from.x(), target.x(), [&](int v) { return ok(v, from.y()); });
+  const int y = Farthest(from.y(), target.y(), [&](int v) { return ok(x, v); });
+  x = Farthest(x, target.x(), [&](int v) { return ok(v, y); });
+  return gfx::Rect(x, y, target.width(), target.height());
+}
