+bool VideoOverlayWindowViews::HandleSailMouseEvent(ui::MouseEvent* event) {
+  switch (event->type()) {
+    case ui::EventType::kMousePressed: {
+      // Presses on the controls, the auto-pip question or the live caption
+      // dialog stay theirs.
+      if (!event->IsOnlyLeftMouseButton() ||
+          ControlsHitTestContainsPoint(event->location()) ||
+          IsOverlayViewShown() ||
+          (live_caption_dialog_ && live_caption_dialog_->GetVisible())) {
+        return false;
+      }
+      if (event->GetClickCount() == 2) {
+        sail_drag_.reset();
+        ToggleFillScreen();
+        event->SetHandled();
+        return true;
+      }
+      ScreenAreas areas = GetScreenAreas();
+      sail_drag_.emplace();
+      sail_drag_->start_cursor = display::Screen::Get()->GetCursorScreenPoint();
+      sail_drag_->start_bounds = GetBounds();
+      sail_drag_->at = sail_drag_->start_bounds;
+      sail_drag_->pass = std::move(areas.pass);
+      sail_drag_->rest = std::move(areas.rest);
+      event->SetHandled();
+      return true;
+    }
+
+    case ui::EventType::kMouseDragged: {
+      if (!sail_drag_) {
+        return false;
+      }
+      const gfx::Vector2d delta =
+          display::Screen::Get()->GetCursorScreenPoint() -
+          sail_drag_->start_cursor;
+      if (!sail_drag_->moved && std::hypot(delta.x(), delta.y()) < 3) {
+        event->SetHandled();
+        return true;
+      }
+      if (!sail_drag_->moved) {
+        sail_drag_->moved = true;
+        bounds_before_fill_.reset();
+      }
+      sail_drag_->at =
+          Reach(sail_drag_->pass, sail_drag_->at, sail_drag_->start_bounds + delta);
+      if (sail_drag_->at != GetBounds()) {
+        SetBounds(sail_drag_->at);
+      }
+      event->SetHandled();
+      return true;
+    }
+
+    case ui::EventType::kMouseReleased: {
+      if (!sail_drag_) {
+        return false;
+      }
+      const SailDrag drag = std::move(*sail_drag_);
+      sail_drag_.reset();
+      if (drag.moved) {
+        // Let go halfway over a menu bar: the window moves down below it.
+        if (!Fits(drag.rest, GetBounds())) {
+          SetBounds(ClampToScreens(drag.rest, GetBounds()));
+        }
+      } else {
+        UpdateControlsVisibility(!AreControlsVisible());
+      }
+      event->SetHandled();
+      return true;
+    }
+
+    case ui::EventType::kMouseCaptureChanged:
+      sail_drag_.reset();
+      return false;
+
+    default:
+      return false;
+  }
+}
+
+bool VideoOverlayWindowViews::HandleSailKeyEvent(ui::KeyEvent* event) {
+  if (event->type() != ui::EventType::kKeyPressed ||
+      event->IsCommandDown() || event->IsControlDown() || event->IsAltDown()) {
+    return false;
+  }
+
+  // Escape brings the window back from filling the screen, and otherwise
+  // brings the video back into its tab.
+  if (event->key_code() == ui::VKEY_ESCAPE) {
+    if (bounds_before_fill_) {
+      ToggleFillScreen();
+    } else {
+      PictureInPictureWindowManager::GetInstance()
+          ->ExitPictureInPictureViaWindowUi(
+              PictureInPictureWindowManager::UiBehavior::
+                  kCloseWindowAndFocusOpener);
+    }
+    event->SetHandled();
+    return true;
+  }
+
+  // The other keys only apply when no button has the keyboard focus.
+  if (GetFocusManager()->GetFocusedView()) {
+    return false;
+  }
+  switch (event->key_code()) {
+    case ui::VKEY_K:
+      if (!show_play_pause_button_) {
+        return false;
+      }
+      TogglePlayPause();
+      break;
+    case ui::VKEY_J:
+      if (is_live_) {
+        return false;
+      }
+      Replay10Seconds();
+      break;
+    case ui::VKEY_L:
+      if (is_live_) {
+        return false;
+      }
+      Forward10Seconds();
+      break;
+    case ui::VKEY_UP:
+    case ui::VKEY_DOWN: {
+      const double current =
+          controller_->GetMuteStatus() ? 0 : controller_->GetVolume();
+      SetSailVolume(current + (event->key_code() == ui::VKEY_UP ? 0.1 : -0.1));
+      break;
+    }
+    case ui::VKEY_M:
+      if (!toggle_mute_button_) {
+        return false;
+      }
+      if (controller_->GetMuteStatus() && controller_->GetVolume() == 0) {
+        // Muted by turning the volume all the way down: come back at half.
+        SetSailVolume(0.5);
+      } else {
+        controller_->RequestMute(!controller_->GetMuteStatus());
+      }
+      break;
+    case ui::VKEY_F:
+      ToggleFillScreen();
+      break;
+    default:
+      return false;
+  }
+  event->SetHandled();
+  return true;
+}
+
+void VideoOverlayWindowViews::ToggleFillScreen() {
+  if (bounds_before_fill_) {
+    const gfx::Rect previous = *bounds_before_fill_;
+    bounds_before_fill_.reset();
+    SetBounds(previous);
+    return;
+  }
+  const gfx::Rect work_area = GetWorkAreaForWindow();
+  if (work_area.IsEmpty()) {
+    return;
+  }
+  bounds_before_fill_ = GetBounds();
+  SetBounds(natural_size_.IsEmpty()
+                ? work_area
+                : media::ComputeLetterboxRegion(work_area, natural_size_));
+}
+
+void VideoOverlayWindowViews::SetSailVolume(double volume) {
+  volume = std::round(std::clamp(volume, 0.0, 1.0) * 100) / 100;
+  controller_->SetVolume(volume);
+  // Like Oblò: all the way down mutes, turning it up again unmutes.
+  const bool muted = controller_->GetMuteStatus();
+  if (volume == 0 && !muted) {
+    controller_->RequestMute(true);
+  } else if (volume > 0 && muted) {
+    controller_->RequestMute(false);
+  }
+}
