+  if (sail_drag_ || bounds_before_fill_ || !IsVisible()) {
+    return;
+  }
+  const std::vector<gfx::Rect> rest = GetScreenAreas().rest;
+  const gfx::Rect bounds = GetBounds();
+  if (!rest.empty() && !Fits(rest, bounds)) {
+    SetBounds(ClampToScreens(rest, bounds));
+  }
