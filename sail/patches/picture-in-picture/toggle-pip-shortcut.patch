 namespace {
 
+// Sail: opens picture-in-picture for the video playing in `contents`, or
+// brings the video back into the page when this tab is already in
+// picture-in-picture. Like the button in the media controls, it works when
+// the page has a single video.
+void ToggleVideoPictureInPicture(content::WebContents* contents) {
+  if (!contents) {
+    return;
+  }
+  auto* manager = PictureInPictureWindowManager::GetInstance();
+  if (manager->GetWebContents() == contents) {
+    manager->ExitPictureInPicture();
+    return;
+  }
+  content::MediaSession::Get(contents)->EnterPictureInPicture();
+}
