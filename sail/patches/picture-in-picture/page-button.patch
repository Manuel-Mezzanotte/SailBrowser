+// Copyright 2026 The Sail Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+// Sail: a picture-in-picture button on the videos in web pages, like the one
+// Zen shows. It comes up at the right edge of the video under the mouse. A
+// click opens picture in picture, or brings the video back if it is already
+// in it.
+
+(() => {
+  "use strict";
+
+  if (globalThis.sailPipButton ||
+      !(document.documentElement instanceof HTMLHtmlElement) ||
+      !document.pictureInPictureEnabled) {
+    return;
+  }
+  globalThis.sailPipButton = true;
+
+  // Like Zen: no button for short clips, previews and tiny videos.
+  const MIN_SECONDS = 45;
+  const MIN_WIDTH = 160;
+  const MIN_HEIGHT = 90;
+  // The button, and its distance from the video's right edge.
+  const SIZE = 40;
+  const MARGIN = 16;
+  // The button goes away when the mouse rests for this long.
+  const IDLE_MS = 2500;
+  // YouTube's hover previews are muted copies of the video: no button there.
+  const SKIP = "#inline-preview-player, ytd-video-preview, #video-preview";
+  const LABEL = "Picture in picture";
+
+  const CSS = `
+    button {
+      all: initial;
+      position: fixed;
+      top: 0;
+      left: 0;
+      box-sizing: border-box;
+      width: ${SIZE}px;
+      height: ${SIZE}px;
+      display: grid;
+      place-items: center;
+      border-radius: 10px;
+      background: rgba(28, 28, 30, .72);
+      border: .5px solid rgba(255, 255, 255, .18);
+      box-shadow: 0 6px 20px rgba(0, 0, 0, .28);
+      backdrop-filter: blur(22px) saturate(180%);
+      color: rgba(255, 255, 255, .92);
+      cursor: pointer;
+      opacity: 0;
+      scale: .9;
+      pointer-events: none;
+      transition: opacity .2s cubic-bezier(.2, .8, .2, 1),
+                  scale .2s cubic-bezier(.2, .8, .2, 1),
+                  background-color .2s;
+    }
+    button.show {
+      opacity: 1;
+      scale: 1;
+      pointer-events: auto;
+    }
+    button:hover {
+      background: rgba(58, 58, 62, .82);
+      color: #fff;
+    }
+    button:active {
+      scale: .88;
+    }
+    button:focus-visible {
+      outline: 2px solid rgba(255, 255, 255, .75);
+      outline-offset: 2px;
+    }
+    svg {
+      display: block;
+      width: 24px;
+      height: 24px;
+    }
+    @media (prefers-reduced-motion: reduce) {
+      button { transition: none; }
+    }
+  `;
+
+  // A window with an arrow going into the small window at its corner.
+  function icon() {
+    const ns = "http://www.w3.org/2000/svg";
+    const svg = document.createElementNS(ns, "svg");
+    svg.setAttribute("viewBox", "0 0 24 24");
+    svg.setAttribute("aria-hidden", "true");
+    const add = (tag, attributes) => {
+      const node = document.createElementNS(ns, tag);
+      for (const [name, value] of Object.entries(attributes)) {
+        node.setAttribute(name, value);
+      }
+      svg.append(node);
+    };
+    const stroke = {
+      fill: "none",
+      stroke: "currentColor",
+      "stroke-width": "1.8",
+      "stroke-linecap": "round",
+      "stroke-linejoin": "round",
+    };
+    add("path", {
+      d: "M11.5 19H5.5A2.5 2.5 0 0 1 3 16.5v-9A2.5 2.5 0 0 1 5.5 5h13" +
+         "A2.5 2.5 0 0 1 21 7.5V10.5",
+      ...stroke,
+    });
+    add("path", {d: "M7.5 8.5l4.6 4.6M12.4 9.3v4.1H8.3", ...stroke});
+    add("rect", {
+      x: "13.5", y: "13", width: "8", height: "6.5", rx: "1.6",
+      fill: "currentColor",
+    });
+    return svg;
+  }
+
+  const videos = document.getElementsByTagName("video");
+  let host = null;
+  let button = null;
+  // The video the button is on.
+  let target = null;
+  let frame = 0;
+  let idleTimer = 0;
+  let x = 0;
+  let y = 0;
+
+  function build() {
+    host = document.createElement("sail-pip-button");
+    host.style.cssText =
+        "all: initial; position: fixed; top: 0; left: 0; width: 0; " +
+        "height: 0; z-index: 2147483647;";
+    const root = host.attachShadow({mode: "closed"});
+    const sheet = new CSSStyleSheet();
+    sheet.replaceSync(CSS);
+    root.adoptedStyleSheets = [sheet];
+
+    button = document.createElement("button");
+    button.type = "button";
+    button.title = LABEL;
+    button.setAttribute("aria-label", LABEL);
+    button.append(icon());
+    root.append(button);
+
+    // The clicks are the button's, not the page's.
+    for (const type of ["pointerdown", "pointerup", "mousedown", "mouseup",
+                        "click", "dblclick", "contextmenu"]) {
+      button.addEventListener(type, (event) => {
+        event.stopPropagation();
+        if (type !== "contextmenu") {
+          event.preventDefault();
+        }
+      });
+    }
+    button.addEventListener("click", toggle);
+  }
+
+  function eligible(video) {
+    if (!video.isConnected || video.disablePictureInPicture ||
+        video.readyState < HTMLMediaElement.HAVE_METADATA ||
+        !video.videoWidth || video.closest(SKIP)) {
+      return false;
+    }
+    const duration = video.duration;
+    if (!(duration === Infinity || duration >= MIN_SECONDS)) {
+      return false;
+    }
+    const rect = video.getBoundingClientRect();
+    return rect.width >= MIN_WIDTH && rect.height >= MIN_HEIGHT;
+  }
+
+  function videoAt() {
+    for (const element of document.elementsFromPoint(x, y)) {
+      if (element.localName === "video") {
+        return element;
+      }
+    }
+    // Videos that let the mouse through (pointer-events: none) are not in
+    // the list above.
+    for (const video of videos) {
+      const rect = video.getBoundingClientRect();
+      if (x >= rect.left && x < rect.right && y >= rect.top &&
+          y < rect.bottom) {
+        return video;
+      }
+    }
+    return null;
+  }
+
+  function update() {
+    frame = 0;
+    const video = videos.length && !document.fullscreenElement ?
+        videoAt() : null;
+    if (video && eligible(video)) {
+      show(video);
+    } else {
+      hide();
+    }
+  }
+
+  function show(video) {
+    if (!host) {
+      build();
+    }
+    if (!host.isConnected) {
+      document.documentElement.append(host);
+    }
+    target = video;
+    const rect = video.getBoundingClientRect();
+    const left = Math.round(rect.right - MARGIN - SIZE);
+    const top = Math.round(rect.top + (rect.height - SIZE) / 2);
+    button.style.translate = `${left}px ${top}px`;
+    button.classList.add("show");
+    clearTimeout(idleTimer);
+    idleTimer = setTimeout(() => {
+      if (!button.matches(":hover")) {
+        hide();
+      }
+    }, IDLE_MS);
+  }
+
+  function hide() {
+    clearTimeout(idleTimer);
+    target = null;
+    button?.classList.remove("show");
+  }
+
+  async function toggle() {
+    const video = target;
+    hide();
+    if (!video) {
+      return;
+    }
+    try {
+      if (document.pictureInPictureElement === video) {
+        await document.exitPictureInPicture();
+      } else {
+        await video.requestPictureInPicture();
+      }
+    } catch {
+      // The site or the browser said no.
+    }
+  }
+
+  const schedule = () => {
+    frame ||= requestAnimationFrame(update);
+  };
+
+  document.addEventListener("pointermove", (event) => {
+    if (event.pointerType === "touch") {
+      return;
+    }
+    x = event.clientX;
+    y = event.clientY;
+    if (videos.length || target) {
+      schedule();
+    }
+  }, {capture: true, passive: true});
+
+  // The mouse left the page.
+  document.addEventListener("mouseout", (event) => {
+    if (!event.relatedTarget) {
+      hide();
+    }
+  }, {capture: true, passive: true});
+
+  // Follow the video while the page scrolls.
+  document.addEventListener("scroll", () => {
+    if (target) {
+      schedule();
+    }
+  }, {capture: true, passive: true});
+
+  document.addEventListener("fullscreenchange", hide);
+})();
