+# Copyright 2026 The Sail Authors
+# You can use, redistribute, and/or modify this source code under
+# the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+# Sail: the built-in extension that puts a picture-in-picture button on the
+# videos in web pages. Packaged like Helium's //components/extstore_fixups.
+
+import("//tools/grit/grit_rule.gni")
+import("//ui/webui/resources/tools/generate_grd.gni")
+
+generated_grd = "$target_gen_dir/resources.grd"
+
+generate_grd("sail_pip_button_grd") {
+  out_grd = generated_grd
+
+  grd_prefix = "sail_pip_button"
+  resource_path_prefix = "sail_pip_button"
+
+  input_files_base_dir = rebase_path(".", "//")
+  input_files = [
+    "manifest.json",
+    "pip-button.js",
+  ]
+}
+
+grit("sail_pip_button") {
+  source = generated_grd
+
+  # Required because the .grd is generated.
+  enable_input_discovery_for_gn_analyze = false
+  output_dir = "$target_gen_dir/resources"
+
+  outputs = [
+    "grit/sail_pip_button_resources.h",
+    "grit/sail_pip_button_resources_map.cc",
+    "grit/sail_pip_button_resources_map.h",
+    "sail_pip_button_resources.pak",
+  ]
+
+  deps = [ ":sail_pip_button_grd" ]
+}
