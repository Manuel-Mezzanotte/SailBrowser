+// Reads the SVG path data of Oblò's icons: M, L, H, V, C, A and Z, absolute
+// or relative, with the numbers written as compactly as SVG allows.
+SkPath ParseSvgPath(std::string_view d) {
+  SkPathBuilder builder;
+  size_t i = 0;
+  const auto skip = [&] {
+    while (i < d.size() && (d[i] == ' ' || d[i] == ',')) {
+      ++i;
+    }
+  };
+  const auto number = [&](float& out) {
+    skip();
+    size_t j = i;
+    bool negative = false;
+    if (j < d.size() && (d[j] == '-' || d[j] == '+')) {
+      negative = d[j] == '-';
+      ++j;
+    }
+    double value = 0;
+    bool digits = false;
+    while (j < d.size() && base::IsAsciiDigit(d[j])) {
+      value = value * 10 + (d[j] - '0');
+      digits = true;
+      ++j;
+    }
+    if (j < d.size() && d[j] == '.') {
+      ++j;
+      double scale = 0.1;
+      while (j < d.size() && base::IsAsciiDigit(d[j])) {
+        value += (d[j] - '0') * scale;
+        scale /= 10;
+        digits = true;
+        ++j;
+      }
+    }
+    if (!digits) {
+      return false;
+    }
+    i = j;
+    out = static_cast<float>(negative ? -value : value);
+    return true;
+  };
+  const auto flag = [&](bool& out) {
+    skip();
+    if (i >= d.size() || (d[i] != '0' && d[i] != '1')) {
+      return false;
+    }
+    out = d[i++] == '1';
+    return true;
+  };
+
+  char command = 0;
+  SkPoint current = {0, 0};
+  SkPoint start = {0, 0};
+  while (true) {
+    skip();
+    if (i >= d.size()) {
+      break;
+    }
+    if (base::IsAsciiAlpha(d[i])) {
+      command = d[i++];
+    } else if (!command) {
+      break;
+    }
+    const SkPoint origin =
+        base::IsAsciiLower(command) ? current : SkPoint{0, 0};
+    switch (base::ToUpperASCII(command)) {
+      case 'M': {
+        float x, y;
+        if (!number(x) || !number(y)) {
+          return builder.detach();
+        }
+        current = origin + SkVector{x, y};
+        start = current;
+        builder.moveTo(current);
+        // More pairs after a move are lines.
+        command = base::IsAsciiLower(command) ? 'l' : 'L';
+        break;
+      }
+      case 'L': {
+        float x, y;
+        if (!number(x) || !number(y)) {
+          return builder.detach();
+        }
+        current = origin + SkVector{x, y};
+        builder.lineTo(current);
+        break;
+      }
+      case 'H': {
+        float x;
+        if (!number(x)) {
+          return builder.detach();
+        }
+        current.fX = origin.fX + x;
+        builder.lineTo(current);
+        break;
+      }
+      case 'V': {
+        float y;
+        if (!number(y)) {
+          return builder.detach();
+        }
+        current.fY = origin.fY + y;
+        builder.lineTo(current);
+        break;
+      }
+      case 'C': {
+        float x1, y1, x2, y2, x, y;
+        if (!number(x1) || !number(y1) || !number(x2) || !number(y2) ||
+            !number(x) || !number(y)) {
+          return builder.detach();
+        }
+        builder.cubicTo(origin + SkVector{x1, y1}, origin + SkVector{x2, y2},
+                        origin + SkVector{x, y});
+        current = origin + SkVector{x, y};
+        break;
+      }
+      case 'A': {
+        float rx, ry, rotation, x, y;
+        bool large, sweep;
+        if (!number(rx) || !number(ry) || !number(rotation) || !flag(large) ||
+            !flag(sweep) || !number(x) || !number(y)) {
+          return builder.detach();
+        }
+        const SkPoint end = origin + SkVector{x, y};
+        // SVG's sweep flag 1 is clockwise.
+        builder.arcTo({rx, ry}, rotation,
+                      large ? SkPathBuilder::kLarge_ArcSize
+                            : SkPathBuilder::kSmall_ArcSize,
+                      sweep ? SkPathDirection::kCW : SkPathDirection::kCCW,
+                      end);
+        current = end;
+        break;
+      }
+      case 'Z':
+        builder.close();
+        current = start;
+        command = 0;
+        break;
+      default:
+        return builder.detach();
+    }
+  }
+  return builder.detach();
+}
