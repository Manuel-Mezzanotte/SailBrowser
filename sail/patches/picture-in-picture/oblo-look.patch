+namespace {
+
+// padding: 5px 10px; the dot is 7 px with 6 px after it.
+constexpr int kLiveHorizontalPadding = 10;
+constexpr int kLiveVerticalPadding = 5;
+constexpr int kLiveDot = 7;
+constexpr int kLiveGap = 6;
+
+}  // namespace
+
+LiveBadge::LiveBadge(const std::u16string& text) {
+  // font-size: 10.5px; font-weight: 700; text-transform: uppercase.
+  const gfx::FontList base;
+  label_ = AddChildView(std::make_unique<views::Label>(base::i18n::ToUpper(text)));
+  label_->SetFontList(
+      base.Derive(11 - base.GetFontSize(), gfx::Font::NORMAL,
+                  gfx::Font::Weight::BOLD));
+  label_->SetEnabledColor(SK_ColorWHITE);
+  label_->SetBackgroundColor(SK_ColorTRANSPARENT);
+  label_->SetAutoColorReadabilityEnabled(false);
+  label_->SetSubpixelRenderingEnabled(false);
+}
+
+LiveBadge::~LiveBadge() = default;
+
+gfx::Size LiveBadge::GetBadgeSize() const {
+  const gfx::Size text = label_->GetPreferredSize();
+  return {kLiveHorizontalPadding + kLiveDot + kLiveGap + text.width() +
+              kLiveHorizontalPadding,
+          std::max(text.height(), kLiveDot) + 2 * kLiveVerticalPadding};
+}
+
+void LiveBadge::OnBoundsChanged(const gfx::Rect& previous_bounds) {
+  GlassPill::OnBoundsChanged(previous_bounds);
+  const gfx::Size text = label_->GetPreferredSize();
+  label_->SetBounds(kLiveHorizontalPadding + kLiveDot + kLiveGap,
+                    (height() - text.height()) / 2, text.width(),
+                    text.height());
+}
+
+void LiveBadge::OnPaint(gfx::Canvas* canvas) {
+  GlassPill::OnPaint(canvas);
+  const gfx::PointF center(kLiveHorizontalPadding + kLiveDot / 2.f,
+                           height() / 2.f);
+  // box-shadow: 0 0 8px rgba(255,69,58,.8).
+  cc::PaintFlags glow = Fill(SkColorSetA(kLiveColor, 204));
+  glow.setImageFilter(sk_make_sp<cc::BlurPaintFilter>(
+      4, 4, SkTileMode::kDecal, nullptr));
+  canvas->DrawCircle(center, kLiveDot / 2.f, glow);
+  canvas->DrawCircle(center, kLiveDot / 2.f, Fill(kLiveColor));
+}
+
+BEGIN_METADATA(LiveBadge)
+END_METADATA
