+
+ProgressRail::ProgressRail(ScrubCallback callback)
+    : callback_(std::move(callback)) {
+  // transition: height .22s cubic-bezier(.2, .8, .2, 1).
+  hover_animation_.SetSlideDuration(base::Milliseconds(220));
+  hover_animation_.SetTweenType(gfx::Tween::LINEAR);
+}
+
+ProgressRail::~ProgressRail() = default;
+
+void ProgressRail::SetFraction(double fraction) {
+  if (scrubbing_) {
+    return;
+  }
+  fraction = std::clamp(fraction, 0.0, 1.0);
+  if (fraction == fraction_) {
+    return;
+  }
+  fraction_ = fraction;
+  SchedulePaint();
+}
+
+void ProgressRail::SetRailHeights(int rail, int hover_rail) {
+  rail_ = rail;
+  hover_rail_ = hover_rail;
+  SchedulePaint();
+}
+
+void ProgressRail::OnPaint(gfx::Canvas* canvas) {
+  const double grow = Ease(hover_animation_.GetCurrentValue());
+  const float thickness = rail_ + (hover_rail_ - rail_) * grow;
+  const gfx::RectF rail(0, (height() - thickness) / 2, width(), thickness);
+  const float radius = thickness / 2;
+  canvas->DrawRoundRect(rail, radius, Fill(kRailColor));
+  gfx::ScopedCanvas scoped(canvas);
+  canvas->sk_canvas()->clipRRect(
+      SkRRect::MakeRectXY(gfx::RectFToSkRect(rail), radius, radius), true);
+  canvas->DrawRect(
+      gfx::RectF(rail.x(), rail.y(), rail.width() * fraction_, rail.height()),
+      Fill(kPlayedColor));
+}
+
+void ProgressRail::OnMouseEntered(const ui::MouseEvent& event) {
+  hover_animation_.Show();
+}
+
+void ProgressRail::OnMouseExited(const ui::MouseEvent& event) {
+  if (!scrubbing_) {
+    hover_animation_.Hide();
+  }
+}
+
+bool ProgressRail::OnMousePressed(const ui::MouseEvent& event) {
+  if (!event.IsOnlyLeftMouseButton()) {
+    return false;
+  }
+  scrubbing_ = true;
+  fraction_ = FractionAt(event.x());
+  hover_animation_.Show();
+  SchedulePaint();
+  callback_.Run(fraction_, /*done=*/false);
+  return true;
+}
+
+bool ProgressRail::OnMouseDragged(const ui::MouseEvent& event) {
+  if (!scrubbing_) {
+    return false;
+  }
+  fraction_ = FractionAt(event.x());
+  SchedulePaint();
+  callback_.Run(fraction_, /*done=*/false);
+  return true;
+}
+
+void ProgressRail::OnMouseReleased(const ui::MouseEvent& event) {
+  EndScrub();
+}
+
+void ProgressRail::OnMouseCaptureLost() {
+  EndScrub();
+}
+
+ui::Cursor ProgressRail::GetCursor(const ui::MouseEvent& event) {
+  return ui::mojom::CursorType::kHand;
+}
+
+void ProgressRail::VisibilityChanged(views::View* starting_from,
+                                     bool is_visible) {
+  if (!is_visible) {
+    hover_animation_.Reset(0);
+  }
+}
+
+void ProgressRail::AnimationProgressed(const gfx::Animation* animation) {
+  SchedulePaint();
+}
+
+double ProgressRail::FractionAt(int x) const {
+  return width() > 0 ? std::clamp(static_cast<double>(x) / width(), 0.0, 1.0)
+                     : 0;
+}
+
+void ProgressRail::EndScrub() {
+  if (!scrubbing_) {
+    return;
+  }
+  scrubbing_ = false;
+  if (!IsMouseHovered()) {
+    hover_animation_.Hide();
+  }
+  callback_.Run(fraction_, /*done=*/true);
+}
