+GlassPill::GlassPill() {
+  SetPaintToLayer();
+  layer()->SetFillsBoundsOpaquely(false);
+  layer()->SetBackgroundBlur(kGlassBlur);
+  layer()->SetIsFastRoundedCorner(true);
+}
+
+GlassPill::~GlassPill() = default;
+
+void GlassPill::LayOutRow(int button) {
+  int x = kPillPadding;
+  for (views::View* child : children()) {
+    if (!child->GetVisible()) {
+      continue;
+    }
+    child->SetBounds(x, kPillPadding, button, button);
+    x += button + kPillGap;
+  }
+  SetSize({std::max(x - kPillGap, kPillPadding) + kPillPadding,
+           button + 2 * kPillPadding});
+}
+
+void GlassPill::OnBoundsChanged(const gfx::Rect& previous_bounds) {
+  // border-radius: 999px.
+  layer()->SetRoundedCornerRadius(
+      gfx::RoundedCornersF(std::min(width(), height()) / 2.f));
+}
+
+void GlassPill::OnPaint(gfx::Canvas* canvas) {
+  const gfx::RectF bounds(GetLocalBounds());
+  const float radius = std::min(bounds.width(), bounds.height()) / 2;
+  canvas->DrawRoundRect(bounds, radius, Fill(kGlassColor));
+  // box-shadow: inset 0 0 0 .5px rgba(255,255,255,.16).
+  gfx::RectF hairline = bounds;
+  hairline.Inset(0.25f);
+  canvas->DrawRoundRect(hairline, std::max(0.f, radius - 0.25f),
+                        Stroke(kHairlineColor, 0.5f));
+}
