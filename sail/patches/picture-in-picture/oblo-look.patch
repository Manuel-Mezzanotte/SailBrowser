+
+VolumeControl::VolumeControl(views::Button::PressedCallback mute_callback,
+                             LevelCallback level_callback,
+                             const std::u16string& label)
+    : level_callback_(std::move(level_callback)) {
+  SetNotifyEnterExitOnChild(true);
+  mute_button_ = AddChildView(std::make_unique<IconButton>(
+      std::move(mute_callback), Icon::kVolume3, label));
+  // transition: height .34s cubic-bezier(.2, .8, .2, 1).
+  open_animation_.SetSlideDuration(base::Milliseconds(340));
+  open_animation_.SetTweenType(gfx::Tween::LINEAR);
+}
+
+VolumeControl::~VolumeControl() = default;
+
+void VolumeControl::SetLevel(double level, const std::u16string& label) {
+  level_ = std::clamp(level, 0.0, 1.0);
+  mute_button_->SetIcon(VolumeIcon(level_), label);
+  SchedulePaint();
+}
+
+void VolumeControl::SetSizes(int button, int slider, int glyph) {
+  button_ = button;
+  slider_ = slider;
+  mute_button_->SetGlyphSize(glyph);
+  mute_button_->SetBounds(kPillPadding, kPillPadding, button, button);
+  UpdateSize();
+}
+
+void VolumeControl::SetShadowView(views::View* view) {
+  shadow_view_ = view;
+}
+
+void VolumeControl::Peek() {
+  peeking_ = true;
+  peek_timer_.Start(FROM_HERE, base::Milliseconds(1200),
+                    base::BindOnce(
+                        [](VolumeControl* control) {
+                          control->peeking_ = false;
+                          control->UpdateOpen();
+                        },
+                        base::Unretained(this)));
+  UpdateOpen();
+}
+
+bool VolumeControl::IsBusy() const {
+  return hovered_ || dragging_ || peeking_;
+}
+
+void VolumeControl::OnMouseEntered(const ui::MouseEvent& event) {
+  hovered_ = true;
+  UpdateOpen();
+}
+
+void VolumeControl::OnMouseExited(const ui::MouseEvent& event) {
+  hovered_ = false;
+  rail_hovered_ = false;
+  UpdateOpen();
+  SchedulePaint();
+}
+
+void VolumeControl::OnMouseMoved(const ui::MouseEvent& event) {
+  const bool on_rail = InSlider(event.location());
+  if (on_rail != rail_hovered_) {
+    rail_hovered_ = on_rail;
+    SchedulePaint();
+  }
+}
+
+bool VolumeControl::OnMousePressed(const ui::MouseEvent& event) {
+  if (!event.IsOnlyLeftMouseButton() || !InSlider(event.location())) {
+    return false;
+  }
+  dragging_ = true;
+  level_callback_.Run(LevelAt(event.y()));
+  SchedulePaint();
+  return true;
+}
+
+bool VolumeControl::OnMouseDragged(const ui::MouseEvent& event) {
+  if (!dragging_) {
+    return false;
+  }
+  level_callback_.Run(LevelAt(event.y()));
+  return true;
+}
+
+void VolumeControl::OnMouseReleased(const ui::MouseEvent& event) {
+  dragging_ = false;
+  UpdateOpen();
+  SchedulePaint();
+}
+
+void VolumeControl::OnMouseCaptureLost() {
+  dragging_ = false;
+  UpdateOpen();
+  SchedulePaint();
+}
+
+bool VolumeControl::OnMouseWheel(const ui::MouseWheelEvent& event) {
+  // Five percent for each notch of the wheel, like Oblò.
+  level_callback_.Run(level_ + 0.05 * event.y_offset() /
+                                   ui::MouseWheelEvent::kWheelDelta);
+  return true;
+}
+
+void VolumeControl::OnPaint(gfx::Canvas* canvas) {
+  GlassPill::OnPaint(canvas);
+  const double open = open_animation_.GetCurrentValue();
+  if (open <= 0) {
+    return;
+  }
+  const gfx::RectF rail = RailBounds();
+  if (rail.IsEmpty()) {
+    return;
+  }
+  // The slider fades in faster than it drops down (opacity .2s).
+  const float alpha = std::min(1.0, open * 1.7);
+  const float radius = rail.width() / 2;
+  canvas->DrawRoundRect(
+      rail, radius,
+      Fill(SkColorSetA(kVolumeRailColor,
+                       base::ClampRound(SkColorGetA(kVolumeRailColor) * alpha))));
+  gfx::ScopedCanvas scoped(canvas);
+  canvas->sk_canvas()->clipRRect(
+      SkRRect::MakeRectXY(gfx::RectFToSkRect(rail), radius, radius), true);
+  const float filled = rail.height() * level_;
+  canvas->DrawRect(
+      gfx::RectF(rail.x(), rail.bottom() - filled, rail.width(), filled),
+      Fill(SkColorSetA(SK_ColorWHITE, base::ClampRound(255 * alpha))));
+}
+
+ui::Cursor VolumeControl::GetCursor(const ui::MouseEvent& event) {
+  return InSlider(event.location()) ? ui::mojom::CursorType::kHand
+                                    : ui::mojom::CursorType::kPointer;
+}
+
+void VolumeControl::VisibilityChanged(views::View* starting_from,
+                                      bool is_visible) {
+  if (is_visible) {
+    return;
+  }
+  // Hidden with the other controls: start closed next time.
+  hovered_ = false;
+  rail_hovered_ = false;
+  dragging_ = false;
+  peeking_ = false;
+  peek_timer_.Stop();
+  open_animation_.Reset(0);
+  UpdateSize();
+}
+
+void VolumeControl::AnimationProgressed(const gfx::Animation* animation) {
+  UpdateSize();
+  SchedulePaint();
+  // The shadow around the pill follows it.
+  if (shadow_view_) {
+    shadow_view_->SchedulePaint();
+  }
+}
+
+void VolumeControl::AnimationEnded(const gfx::Animation* animation) {
+  AnimationProgressed(animation);
+}
+
+void VolumeControl::UpdateOpen() {
+  if (IsBusy()) {
+    open_animation_.Show();
+  } else {
+    open_animation_.Hide();
+  }
+}
+
+void VolumeControl::UpdateSize() {
+  const double open = Ease(open_animation_.GetCurrentValue());
+  SetSize({button_ + 2 * kPillPadding,
+           button_ + 2 * kPillPadding + base::ClampRound(slider_ * open)});
+}
+
+bool VolumeControl::InSlider(const gfx::Point& point) const {
+  return open_animation_.GetCurrentValue() > 0 &&
+         point.y() >= kPillPadding + button_;
+}
+
+gfx::RectF VolumeControl::RailBounds() const {
+  // The slider is `slider_` tall under the speaker, with 6 px of padding at
+  // the top and half a button less 4 px at the bottom. The rail widens from
+  // 6 to 9 px under the mouse.
+  const float top = kPillPadding + button_ + 6;
+  const float bottom = kPillPadding + button_ + slider_ - (button_ / 2.f - 4);
+  const float rail_width = (rail_hovered_ || dragging_) ? 9 : 6;
+  return gfx::RectF(width() / 2.f - rail_width / 2, top, rail_width,
+                    std::max(0.f, bottom - top));
+}
+
+double VolumeControl::LevelAt(int y) const {
+  const gfx::RectF rail = RailBounds();
+  if (rail.height() <= 0) {
+    return level_;
+  }
+  return std::clamp(1 - (y - rail.y()) / rail.height(), 0.0f, 1.0f);
+}
