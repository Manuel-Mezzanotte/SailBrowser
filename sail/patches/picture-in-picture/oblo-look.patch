+void IconButton::SetIcon(Icon icon, const std::u16string& label) {
+  if (icon != icon_) {
+    icon_ = icon;
+    SchedulePaint();
+  }
+  if (label != GetTooltipText()) {
+    GetViewAccessibility().SetName(label);
+    SetTooltipText(label);
+  }
+}
