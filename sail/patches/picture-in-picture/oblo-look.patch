+IconButton::IconButton(PressedCallback callback,
+                       Icon icon,
+                       const std::u16string& label)
+    : views::Button(std::move(callback)), icon_(icon) {
+  // Act as soon as the button is pressed, like the media controls of macOS:
+  // the release can be lost while the picture-in-picture window becomes the
+  // active window, which left the button pressed without doing anything.
+  button_controller()->set_notify_action(
+      views::ButtonController::NotifyAction::kOnPress);
+  SetAnimationDuration(base::Milliseconds(200));
+  views::InstallCircleHighlightPathGenerator(this);
+  GetViewAccessibility().SetName(label);
+  SetTooltipText(label);
+}
