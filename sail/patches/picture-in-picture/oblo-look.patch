+  sail_close_button_ =
+      window_pill->AddChildView(std::make_unique<sail_oblo::IconButton>(
+          base::BindRepeating(
+              &VideoOverlayWindowViews::CloseAndPauseIfAvailable,
+              base::Unretained(this)),
+          sail_oblo::Icon::kClose,
+          l10n_util::GetStringUTF16(IDS_PICTURE_IN_PICTURE_CLOSE_CONTROL_TEXT)));
+  sail_back_to_tab_button_ =
+      window_pill->AddChildView(std::make_unique<sail_oblo::IconButton>(
+          base::BindRepeating([] {
+            PictureInPictureWindowManager::GetInstance()
+                ->ExitPictureInPictureViaWindowUi(
+                    PictureInPictureWindowManager::UiBehavior::
+                        kCloseWindowAndFocusOpener);
+          }),
+          sail_oblo::Icon::kReturnToTab,
+          l10n_util::GetStringUTF16(
+              IDS_PICTURE_IN_PICTURE_BACK_TO_TAB_CONTROL_TEXT)));
+  sail_window_pill_ = AddChildView(&view_holder_, std::move(window_pill));
+
+  // Top right: the volume.
+  sail_volume_ = AddChildView(
+      &view_holder_,
+      std::make_unique<sail_oblo::VolumeControl>(
+          base::BindRepeating(&VideoOverlayWindowViews::ToggleSailMute,
+                              base::Unretained(this)),
+          base::BindRepeating(&VideoOverlayWindowViews::SetSailVolume,
+                              base::Unretained(this)),
+          l10n_util::GetStringUTF16(IDS_PICTURE_IN_PICTURE_MUTE_TEXT)));
+  sail_volume_->SetShadowView(controls_container_view_);
+
+  // Middle: back ten seconds, play/pause, forward ten seconds.
+  const auto add_center_button = [this](base::RepeatingClosure callback,
+                                        sail_oblo::Icon icon, int label) {
+    auto button = std::make_unique<sail_oblo::IconButton>(
+        std::move(callback), icon, l10n_util::GetStringUTF16(label));
