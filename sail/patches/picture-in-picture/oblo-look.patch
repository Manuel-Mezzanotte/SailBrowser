+void IconButton::SetCenterStyle(bool center) {
+  center_ = center;
+  SchedulePaint();
+}
+
+void IconButton::PaintButtonContents(gfx::Canvas* canvas) {
+  const gfx::RectF bounds(GetLocalBounds());
+  const double hover = GetEnabled() ? hover_animation().GetCurrentValue() : 0;
+
+  // background: rgba(255,255,255,.14) under the mouse, .1 for the center.
+  const double wash = hover * (center_ ? 0.10 : 0.14);
+  if (wash > 0) {
+    canvas->DrawCircle(
+        bounds.CenterPoint(), std::min(bounds.width(), bounds.height()) / 2,
+        Fill(SkColorSetA(SK_ColorWHITE, base::ClampRound(wash * 255))));
+  }
+
+  gfx::ScopedCanvas scoped(canvas);
+  // transform: scale(.88) while pressed.
+  if (GetState() == STATE_PRESSED) {
+    const gfx::PointF center = bounds.CenterPoint();
+    canvas->sk_canvas()->translate(center.x(), center.y());
+    canvas->sk_canvas()->scale(0.88f, 0.88f);
+    canvas->sk_canvas()->translate(-center.x(), -center.y());
+  }
+
+  // rgba(255,255,255,.92), white under the mouse.
+  const SkColor color = SkColorSetA(
+      kIconColor, SkColorGetA(kIconColor) +
+                      base::ClampRound((255 - SkColorGetA(kIconColor)) * hover));
+  const gfx::RectF glyph(bounds.CenterPoint().x() - glyph_size_ / 2.f,
+                         bounds.CenterPoint().y() - glyph_size_ / 2.f,
+                         glyph_size_, glyph_size_);
+  if (!center_) {
+    PaintIcon(canvas, icon_, glyph, color);
+    return;
+  }
+  // filter: drop-shadow(0 1px 8px rgba(0,0,0,.4)).
+  cc::PaintFlags shadow;
+  shadow.setImageFilter(sk_make_sp<cc::DropShadowPaintFilter>(
+      0, 1, 4, 4, SkColor4f{0, 0, 0, 0.4f},
+      cc::DropShadowPaintFilter::ShadowMode::kDrawShadowAndForeground,
+      nullptr));
+  canvas->sk_canvas()->saveLayer(shadow);
+  PaintIcon(canvas, icon_, glyph, color);
+  canvas->sk_canvas()->restore();
+}
+
+ui::Cursor IconButton::GetCursor(const ui::MouseEvent& event) {
+  return ui::mojom::CursorType::kHand;
+}
