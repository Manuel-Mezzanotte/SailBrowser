+void VideoOverlayWindowViews::LayoutSailControls() {
+  const gfx::Size size = GetBounds().size();
+  if (size.IsEmpty() || !sail_window_pill_) {
+    return;
+  }
+  const sail_oblo::Metrics m(size);
+
+  // Top: the window's buttons at the left, the volume at the right.
+  sail_close_button_->SetGlyphSize(m.glyph);
+  sail_back_to_tab_button_->SetGlyphSize(m.glyph);
+  sail_window_pill_->LayOutRow(m.button);
+  sail_window_pill_->SetPosition({m.edge, m.edge});
+  sail_volume_->SetSizes(m.button, m.volume, m.glyph);
+  sail_volume_->SetPosition(
+      {size.width() - m.edge - sail_volume_->width(), m.edge});
+
+  // Middle, centered on the whole window. Live videos cannot seek.
+  const bool show_seek = !is_live_ && !m.small;
+  sail_back_button_->SetVisible(show_seek);
+  sail_forward_button_->SetVisible(show_seek);
+  sail_play_pause_button_->SetVisible(show_play_pause_button_);
+  const std::pair<sail_oblo::IconButton*, int> center[] = {
+      {sail_back_button_.get(), m.skip},
+      {sail_play_pause_button_.get(), m.play},
+      {sail_forward_button_.get(), m.skip},
+  };
+  int total = -m.center_gap;
+  for (const auto& [button, glyph] : center) {
+    if (button->GetVisible()) {
+      total += glyph + 2 * m.center_padding + m.center_gap;
+    }
+  }
+  int x = (size.width() - total) / 2;
+  for (const auto& [button, glyph] : center) {
+    if (!button->GetVisible()) {
+      continue;
+    }
+    const int side = glyph + 2 * m.center_padding;
+    button->SetGlyphSize(glyph);
+    button->SetBounds(x, (size.height() - side) / 2, side, side);
+    x += side + m.center_gap;
+  }
+
+  // Bottom row.
+  const int left = m.bottom_side;
+  const int right = size.width() - m.bottom_side;
+  const int bottom = size.height() - m.bottom_edge;
+  const bool show_times = !is_live_ && !m.small;
+  sail_elapsed_->SetVisible(show_times);
+  sail_remaining_->SetVisible(show_times);
+  sail_progress_->SetVisible(!is_live_);
+  sail_live_->SetVisible(is_live_);
+
+  const gfx::FontList font = sail_oblo::TimeFont(m.time_font);
+  sail_elapsed_->SetFontList(font);
+  sail_remaining_->SetFontList(font);
+  sail_time_template_ = sail_oblo::TimeTemplate(position_.duration());
+  // min-width: 3.1em.
+  const int time_width =
+      std::max(base::ClampCeil(3.1 * m.time_font),
+               gfx::GetStringWidth(sail_time_template_, font));
+  const int time_height = font.GetHeight();
+  const int row = std::max(m.track, time_height);
+  const int row_top = bottom - row;
+  int rail_left = left;
+  int rail_right = right;
+  if (show_times) {
+    const int y = row_top + (row - time_height) / 2;
+    sail_elapsed_->SetBounds(left, y, time_width, time_height);
+    sail_remaining_->SetBounds(right - time_width, y, time_width, time_height);
+    rail_left += time_width + m.bottom_gap;
+    rail_right -= time_width + m.bottom_gap;
+  }
+  sail_progress_->SetRailHeights(m.rail, m.rail_hover);
+  sail_progress_->SetBounds(rail_left, row_top + (row - m.track) / 2,
+                            std::max(0, rail_right - rail_left), m.track);
+
+  const gfx::Size badge = sail_live_->GetBadgeSize();
+  sail_live_->SetBounds((size.width() - badge.width()) / 2,
+                        bottom - badge.height(), badge.width(),
+                        badge.height());
+
+  // The pills' shadows are painted by the controls container.
+  controls_container_view_->SchedulePaint();
+  UpdateSailProgress();
+}
+
+void VideoOverlayWindowViews::HideChromiumControls() {
+  views::View* const controls[] = {
+      close_controls_view_.get(),
+      minimize_button_.get(),
+      back_to_tab_button_.get(),
+      play_pause_controls_view_.get(),
+      replay_10_seconds_button_.get(),
+      forward_10_seconds_button_.get(),
+      previous_track_controls_view_.get(),
+      next_track_controls_view_.get(),
+      progress_view_.get(),
+      timestamp_.get(),
+      live_status_.get(),
+      toggle_mute_button_.get(),
+  };
+  for (views::View* control : controls) {
+    if (control) {
+      control->SetVisible(false);
+    }
+  }
+}
+
+void VideoOverlayWindowViews::MaybeHideSailControls() {
+  if (!sail_playing_ || sail_drag_ || IsSailControlActive()) {
+    return;
+  }
+  UpdateControlsVisibility(false);
+  // cursor: none while the controls are away.
+  if (GetWindowBoundsInScreen().Contains(
+          display::Screen::Get()->GetCursorScreenPoint())) {
+    SetCursor(ui::Cursor(ui::mojom::CursorType::kNone));
+  }
+}
+
+bool VideoOverlayWindowViews::IsSailControlActive() const {
+  if (!sail_volume_) {
+    return false;
+  }
+  if (sail_volume_->IsBusy() || sail_progress_->scrubbing()) {
+    return true;
+  }
+  const views::View* const controls[] = {
+      sail_window_pill_.get(),      sail_volume_.get(),
+      sail_back_button_.get(),      sail_play_pause_button_.get(),
+      sail_forward_button_.get(),   sail_progress_.get(),
+  };
+  return std::ranges::any_of(controls, [](const views::View* control) {
+    return control->IsDrawn() && control->IsMouseHovered();
+  });
+}
+
+void VideoOverlayWindowViews::SetSailPlaybackState(
+    PlaybackState playback_state) {
+  if (!sail_play_pause_button_) {
+    return;
+  }
+  const bool playing = playback_state == kPlaying;
+  sail_play_pause_button_->SetIcon(
+      playing ? sail_oblo::Icon::kPause : sail_oblo::Icon::kPlay,
+      l10n_util::GetStringUTF16(
+          playing ? IDS_PICTURE_IN_PICTURE_PAUSE_CONTROL_TEXT
+          : playback_state == kEndOfVideo
+              ? IDS_PICTURE_IN_PICTURE_REPLAY_CONTROL_TEXT
+              : IDS_PICTURE_IN_PICTURE_PLAY_CONTROL_TEXT));
+  if (playing == sail_playing_) {
+    return;
+  }
+  sail_playing_ = playing;
+  // Like Oblò, the controls come up for a moment when the video starts or
+  // stops.
+  if (IsVisible()) {
+    UpdateControlsVisibility(true);
+    hide_controls_timer_.Reset();
+  }
+}
+
+void VideoOverlayWindowViews::UpdateSailProgress() {
+  if (!sail_progress_ || is_live_ || !AreControlsVisible()) {
+    return;
+  }
+  const base::TimeDelta duration =
+      std::max(position_.duration(), base::TimeDelta());
+  if (sail_oblo::TimeTemplate(duration) != sail_time_template_) {
+    // The video is longer or shorter by a digit: the times need more or less
+    // room.
+    LayoutSailControls();
+    return;
+  }
+  base::TimeDelta current;
+  if (sail_progress_->scrubbing()) {
+    current = duration * sail_progress_->fraction();
+  } else {
+    current = std::clamp(position_.GetPosition(), base::TimeDelta(), duration);
+    sail_progress_->SetFraction(duration.is_positive() ? current / duration
+                                                       : 0);
+  }
+  sail_elapsed_->SetText(sail_oblo::FormatTime(current));
+  sail_remaining_->SetText(u"-" + sail_oblo::FormatTime(duration - current));
+}
+
+void VideoOverlayWindowViews::OnSailScrub(double fraction, bool done) {
+  if (done) {
+    SeekForProgressBarInteraction(fraction);
+    // Show the new position right away, as Oblò does, rather than the old one
+    // until the video reports back.
+    position_ = media_session::MediaPosition(
+        position_.playback_rate(), position_.duration(),
+        position_.duration() * fraction, /*end_of_media=*/false);
+  }
+  UpdateSailProgress();
+}
+
+void VideoOverlayWindowViews::ToggleSailMute() {
+  const double volume = controller_->GetVolume();
+  if (sail_muted_ || volume == 0) {
+    SetSailVolume(volume > 0.02 ? volume : 0.5);
+  } else {
+    RequestSailMute(true);
+    UpdateSailVolume();
+  }
+}
+
+void VideoOverlayWindowViews::RequestSailMute(bool mute) {
+  sail_muted_ = mute;
+  controller_->RequestMute(mute);
+}
+
+void VideoOverlayWindowViews::UpdateSailVolume() {
+  if (!sail_volume_) {
+    return;
+  }
+  const double level = sail_muted_ ? 0 : controller_->GetVolume();
+  sail_volume_->SetLevel(
+      level, l10n_util::GetStringUTF16(level == 0
+                                           ? IDS_PICTURE_IN_PICTURE_UNMUTE_TEXT
+                                           : IDS_PICTURE_IN_PICTURE_MUTE_TEXT));
+}
