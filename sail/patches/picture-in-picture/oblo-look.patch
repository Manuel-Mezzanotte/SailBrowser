+// PillShadows -----------------------------------------------------------------
+
+PillShadows::PillShadows(std::vector<raw_ptr<views::View>> pills)
+    : pills_(std::move(pills)) {}
+
+PillShadows::~PillShadows() = default;
+
+void PillShadows::Paint(gfx::Canvas* canvas, views::View* view) const {
+  for (views::View* pill : pills_) {
+    if (!pill || !pill->GetVisible() || !pill->parent() || pill->size().IsEmpty()) {
+      continue;
+    }
+    const gfx::RectF bounds = views::View::ConvertRectToTarget(
+        pill->parent(), view, gfx::RectF(pill->bounds()));
+    const float radius = std::min(bounds.width(), bounds.height()) / 2;
+    const SkRRect rrect =
+        SkRRect::MakeRectXY(gfx::RectFToSkRect(bounds), radius, radius);
+    gfx::ScopedCanvas scoped(canvas);
+    canvas->sk_canvas()->clipRRect(rrect, SkClipOp::kDifference, true);
+    // box-shadow: 0 6px 20px rgba(0,0,0,.28).
+    cc::PaintFlags flags = Fill(SK_ColorBLACK);
+    flags.setImageFilter(sk_make_sp<cc::DropShadowPaintFilter>(
+        0, 6, 10, 10, SkColor4f{0, 0, 0, 0.28f},
+        cc::DropShadowPaintFilter::ShadowMode::kDrawShadowOnly, nullptr));
+    canvas->sk_canvas()->drawRRect(rrect, flags);
+  }
+}
+
+// Times -----------------------------------------------------------------------
+
+std::unique_ptr<views::Background> CreateShadeBackground() {
+  return std::make_unique<ShadeBackground>();
+}
+
+void StyleTimeLabel(views::Label* label, bool end) {
+  // color: rgba(255,255,255,.82); text-shadow: 0 1px 4px rgba(0,0,0,.45).
+  label->SetEnabledColor(kTimeColor);
+  label->SetBackgroundColor(SK_ColorTRANSPARENT);
+  label->SetAutoColorReadabilityEnabled(false);
+  label->SetSubpixelRenderingEnabled(false);
+  label->SetShadows({gfx::ShadowValue(gfx::Vector2d(0, 1), 4,
+                                      SkColorSetARGB(115, 0, 0, 0))});
+  label->SetHorizontalAlignment(end ? gfx::ALIGN_RIGHT : gfx::ALIGN_LEFT);
+}
+
+gfx::FontList TimeFont(int size) {
+  // font-weight: 600.
+  const gfx::FontList base;
+  return base.Derive(size - base.GetFontSize(), gfx::Font::NORMAL,
+                     gfx::Font::Weight::SEMIBOLD);
+}
+
+std::u16string FormatTime(base::TimeDelta time) {
+  const int total = std::max(0, base::ClampFloor(time.InSecondsF()));
+  const int hours = total / 3600;
+  const int minutes = (total % 3600) / 60;
+  const int seconds = total % 60;
+  return base::ASCIIToUTF16(
+      hours ? base::StringPrintf("%d:%02d:%02d", hours, minutes, seconds)
+            : base::StringPrintf("%d:%02d", minutes, seconds));
+}
+
+std::u16string TimeTemplate(base::TimeDelta duration) {
+  std::u16string text =
+      u"-" + FormatTime(duration.is_positive() && !duration.is_max()
+                            ? duration
+                            : base::TimeDelta());
+  for (char16_t& c : text) {
+    if (base::IsAsciiDigit(c)) {
+      c = u'0';
+    }
+  }
+  return text;
+}
